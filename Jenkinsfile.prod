pipeline {
    agent { label 'linux-agent' }
    environment {
        DOCKER_IMAGE = 'krati07/jenkins-docker-demo'
        CODE_REPO_URL = 'https://github.com/KratiP23/docker-jenkins-app.git'
    }
    stages {
        stage('Checkout code repo') {
            steps {
                checkout([$class: 'GitSCM', branches: [[name: 'main']],
                          userRemoteConfigs: [[url: "${CODE_REPO_URL}"]]])
                script { env.TESTED_SHA = sh(script: 'git rev-parse --short HEAD^2', returnStdout: true).trim() }
            }
        }
        stage('Pull tested image and promote to prod') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                        docker pull ${DOCKER_IMAGE}:${TESTED_SHA}
                        docker tag ${DOCKER_IMAGE}:${TESTED_SHA} ${DOCKER_IMAGE}:prod
                        docker push ${DOCKER_IMAGE}:prod
                    '''
                }
            }
        }
    }
}